# ════════════════════════════════════════════════════════════
# MOVENTRA SAFARIS & LOGISTICS — ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your values
# ════════════════════════════════════════════════════════════

# ── App Security (REQUIRED — change before hosting) ─────────
API_INTERNAL_SECRET=generate-a-random-32-char-string-here
NEXT_PUBLIC_API_SECRET=generate-a-random-32-char-string-here

# ── Supabase (REQUIRED) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── M-Pesa Daraja (REQUIRED for payments) ───────────────────
# Get from: https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-passkey
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback
MPESA_ENV=sandbox
NEXT_PUBLIC_MPESA_PAYBILL=174379

# ── KRA eTIMS (REQUIRED for legal receipts) ─────────────────
# Get from: https://etims.kra.go.ke
ETIMS_DEVICE_NUMBER=your-device-number
ETIMS_API_KEY=your-api-key
ETIMS_VSCU_URL=https://etims-api.kra.go.ke

# ── Email via Resend (REQUIRED for confirmations) ───────────
# Free at: https://resend.com
RESEND_API_KEY=re_your_api_key
FROM_EMAIL=receipts@moventrasafarislogisticsltd.com

# ── SMS via Africa's Talking (REQUIRED for notifications) ───
# Free sandbox: https://africastalking.com
AT_API_KEY=your-api-key
AT_USERNAME=sandbox
AT_SENDER_ID=MOVENTRA

# ── Google Maps (OPTIONAL — for location features) ──────────
# Get from: https://console.cloud.google.com
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-maps-key
