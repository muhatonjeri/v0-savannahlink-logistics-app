# ── Supabase (Required) ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── M-Pesa Daraja (Critical - Core Payments) ───────────────────────
# Get from: https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-passkey
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback
MPESA_ENV=sandbox
# Also set for display in invoices:
NEXT_PUBLIC_MPESA_PAYBILL=174379

# ── eTIMS KRA (Legal Requirement) ─────────────────────────────────
# Get from: https://etims.kra.go.ke
ETIMS_DEVICE_NUMBER=your-device-number
ETIMS_API_KEY=your-api-key
ETIMS_VSCU_URL=https://etims-api.kra.go.ke

# ── Email via Resend (High Priority) ──────────────────────────────
# Get free key at: https://resend.com
RESEND_API_KEY=re_your_api_key
FROM_EMAIL=receipts@moventrasafarislogisticsltd.com

# ── SMS via Africa's Talking (Medium) ─────────────────────────────
# Get from: https://africastalking.com
AT_API_KEY=your-api-key
AT_USERNAME=sandbox
AT_SENDER_ID=MOVENTRA

# ── Google Maps (Optional) ─────────────────────────────────────────
# Get from: https://console.cloud.google.com
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-maps-key
